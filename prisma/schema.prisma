generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  company   String?
  whatsapp  String?
  email     String?
  niche     String?
  notes     String?
  status    String   @default("ativo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients   Client[]
}

model Client {
  id                 String     @id @default(cuid())
  name               String
  company            String?
  whatsapp           String?
  email              String?
  segment            String?
  leadSource         String?
  status             String     @default("lead")
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  acquisitionChannel String?
  niche              String?
  city               String?
  hasGmn             Boolean?
  hasSite            Boolean?
  nextFollowUpAt     DateTime?
  objection          String?
  packageTier        String?
  serviceInterest    String?
  partnerId          String?
  partner            Partner?   @relation(fields: [partnerId], references: [id])
  activities         Activity[]
  contracts          Contract[]
  deals              Deal[]
  proposals          Proposal[]
  tasks              Task[]
}

model Deal {
  id             String     @id @default(cuid())
  clientId       String
  serviceType    String
  estimatedValue Float
  stage          String     @default("lead_novo")
  lastActivityAt DateTime   @default(now())
  stageEnteredAt DateTime   @default(now())
  lostReason     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  activities     Activity[]
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal       Proposal?
  tasks          Task[]
}

model Proposal {
  id           String   @id @default(cuid())
  clientId     String
  dealId       String?  @unique
  title        String
  serviceType  String
  summary      String?
  scope        String?
  timeline     String?
  investment   Float?
  paymentTerms String?
  status       String   @default("rascunho")
  version      Int      @default(1)
  shareToken   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  monthlyValue Float?
  packageTier  String?
  setupValue   Float?
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal         Deal?    @relation(fields: [dealId], references: [id])
}

model Contract {
  id           String    @id @default(cuid())
  clientId     String
  service      String
  type         String
  monthlyValue Float?
  totalValue   Float?
  startDate    DateTime
  endDate      DateTime?
  status       String    @default("ativo")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  setupValue   Float?
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments     Payment[]
}

model Payment {
  id         String    @id @default(cuid())
  contractId String
  amount     Float
  dueDate    DateTime
  status     String    @default("pendente")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  title     String
  type      String
  priority  String   @default("media")
  dueDate   DateTime
  completed Boolean  @default(false)
  clientId  String?
  dealId    String?
  automated Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String    @id @default(cuid())
  name           String
  company        String?
  whatsapp       String?
  email          String?
  niche          String?
  city           String?
  source         String?
  callStatus     String    @default("nao_contatado")
  lastCallAt     DateTime?
  nextFollowUpAt DateTime?
  notes          String?
  callNotes      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  content   String
  clientId  String?
  dealId    String?
  createdAt DateTime @default(now())
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deal      Deal?    @relation(fields: [dealId], references: [id])
}
